              "type": "query_value",
              "requests": [
                {
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "success",
                      "query": "sum:ibm_b2b.processes.success{*}",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "total",
                      "query": "sum:ibm_b2b.processes.total{*}",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "(success / total) * 100"
                    }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 90,
                      "palette": "white_on_green"
                    },
                    {
                      "comparator": "<",
                      "value": 90,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<",
                      "value": 50,
                      "palette": "white_on_red"
                    }
