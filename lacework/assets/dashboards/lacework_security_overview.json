{
  "title": "Lacework - Security Overview",
  "description": "Lacework FortiCNAPP security alerts forwarded to Datadog, by severity, category and alert type, with the Cloud SIEM signals for the source.",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "alert_type",
      "prefix": "@evt.name",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "category",
      "prefix": "@evt.category",
      "available_values": [],
      "default": "*"
    },
    {
      "name": "severity",
      "prefix": "@severity",
      "available_values": [],
      "default": "*"
    }
  ],
  "widgets": [
    {
      "id": 5877886686474204,
      "definition": {
        "title": "Lacework",
        "show_title": false,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 6806324622707781,
            "definition": {
              "type": "note",
              "content": "This dashboard gives an overview of the security alerts Lacework FortiCNAPP forwards to Datadog: cloud activity, workload, Kubernetes, compliance, vulnerability and threat-intel alerts, by severity, category and alert type.\n\nUse the template variables to pivot on an alert type, category or severity, and open single alerts in the **Lacework Alert Details** stream.\n\nFor further reading, see:\n\n- [Lacework integration documentation](https://docs.datadoghq.com/integrations/lacework/)\n\n- [Lacework FortiCNAPP alerts reference](https://docs.fortinet.com/document/forticnapp/latest/alerts-reference)\n\n- [Datadog Cloud SIEM](https://docs.datadoghq.com/security/cloud_siem/)",
              "background_color": "transparent",
              "font_size": "14",
              "text_align": "left",
              "vertical_align": "top",
              "show_tick": false,
              "tick_pos": "50%",
              "tick_edge": "left",
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 4
            }
          }
        ],
        "banner_img": "/static/images/integration_dashboard/lacework_hero_1.png"
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 6,
        "height": 7
      }
    },
    {
      "id": 2385235210738916,
      "definition": {
        "title": "Lacework Log Overview",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 6100815577627202,
            "definition": {
              "title": "Lacework alerts over time by category",
              "title_size": "16",
              "title_align": "left",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "sum"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "logs",
                      "name": "query1",
                      "indexes": [
                        "*"
                      ],
                      "compute": {
                        "aggregation": "count"
                      },
                      "group_by": [
                        {
                          "facet": "@evt.category",
                          "limit": 10,
                          "sort": {
                            "order": "desc",
                            "aggregation": "count"
                          }
                        }
                      ],
                      "search": {
                        "query": "source:lacework $alert_type $category $severity"
                      },
                      "storage": "hot"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "display_type": "bars",
                  "style": {
                    "palette": "datadog16",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
