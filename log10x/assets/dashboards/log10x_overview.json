              "y": 1,
              "width": 6,
              "height": 3
            }
          },
          {
            "id": 1000000000000014,
            "definition": {
              "title": "Forwarded bytes as a share of bytes read",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value",
                "sum"
              ],
              "type": "timeseries",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1 / query2"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:log10x.bytes.forwarded.count{$tenx_env,$tenx_user_service}.as_count().rollup(sum, 300)"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query2",
                      "query": "sum:log10x.bytes.read.count{$tenx_env,$tenx_user_service}.as_count().rollup(sum, 300)"
                    }
                  ],
                  "response_format": "timeseries",
                  "style": {
                    "palette": "dog_classic",
