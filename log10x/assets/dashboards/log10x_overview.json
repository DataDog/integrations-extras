            "id": 1000000000000021,
            "definition": {
              "type": "note",
              "content": "Every series carries `message_pattern`, `severity_level`, `tenx_user_service` and the Kubernetes container. These rank patterns by what they contribute.",
              "background_color": "blue",
              "font_size": "14",
              "text_align": "center",
              "vertical_align": "center",
              "show_tick": false,
              "tick_pos": "50%",
