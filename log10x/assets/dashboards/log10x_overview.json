                      "formula": "query1"
                    },
                    {
                      "formula": "query2"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:log10x.events.read.count{$tenx_env,$tenx_user_service}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query2",
                      "query": "sum:log10x.events.forwarded.count{$tenx_env,$tenx_user_service}.as_count()"
                    }
