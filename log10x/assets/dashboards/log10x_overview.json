          {
            "id": 1000000000000022,
            "definition": {
              "title": "Top patterns by bytes read",
              "title_size": "16",
              "title_align": "left",
              "type": "toplist",
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1",
                      "limit": {
                        "count": 20,
                        "order": "desc"
                      }
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:log10x.bytes.read.count{$tenx_env,$tenx_user_service} by {message_pattern}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "response_format": "scalar"
