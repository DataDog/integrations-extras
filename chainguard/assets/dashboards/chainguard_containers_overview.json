    {
      "definition": {
        "background_color": "green",
        "layout_type": "ordered",
        "show_title": true,
        "title": "Cloud Security Management",
        "type": "group",
        "widgets": [
          {
            "definition": {
              "background_color": "green",
              "content": "These widgets require the [Cloud Security Management product](https://docs.datadoghq.com/security/cloud_security_management/vulnerabilities/) to populate.",
              "font_size": "16",
              "has_padding": true,
              "show_tick": false,
              "text_align": "left",
              "tick_edge": "left",
              "tick_pos": "50%",
              "type": "note",
              "vertical_align": "center"
            },
            "id": 7900021519410556,
            "layout": {
              "height": 1,
              "width": 6,
              "x": 0,
              "y": 0
            }
          },
          {
            "definition": {
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1"
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:contimage.vuln_count{$env,$cluster_name,$short_image} by {image_name}"
                    }
                  ],
                  "response_format": "scalar",
                  "sort": {
                    "count": 500,
                    "order_by": [
                      {
                        "index": 0,
                        "order": "desc",
                        "type": "formula"
                      }
                    ]
                  }
                }
              ],
              "title": "Distribution of Image Vulnerabilities",
              "title_align": "left",
              "title_size": "16",
              "type": "sunburst"
            },
            "id": 1818972211272584,
            "layout": {
              "height": 5,
              "width": 6,
              "x": 6,
              "y": 0
            }
          },
          {
            "definition": {
              "requests": [
                {
                  "formulas": [
                    {
                      "alias": "Running Containers",
                      "formula": "query1"
                    },
                    {
                      "alias": "Percent change (from last week)",
                      "formula": "((query1 - calendar_shift(query2, '-1w', 'UTC')) / calendar_shift(query2, '-1w', 'UTC')) * 100",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      }
                    },
                    {
                      "alias": "Vulnerability Count",
                      "formula": "query3"
                    }
                  ],
                  "queries": [
                    {
                      "aggregator": "avg",
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "sum:contimage.running_containers{$env,$cluster_name,$short_image} by {image_name}"
                    },
                    {
                      "aggregator": "avg",
                      "data_source": "metrics",
                      "name": "query2",
                      "query": "sum:contimage.running_containers{$env,$cluster_name,$short_image} by {image_name}"
                    },
                    {
                      "aggregator": "avg",
                      "data_source": "metrics",
                      "name": "query3",
                      "query": "sum:contimage.vuln_count{$env,$cluster_name,$short_image} by {image_name}"
                    }
                  ],
                  "response_format": "scalar",
                  "sort": {
                    "count": 25,
                    "order_by": [
                      {
                        "index": 0,
                        "order": "desc",
                        "type": "formula"
                      }
                    ]
                  }
                }
              ],
              "title": "Vulnerabilities in Most Used Images",
              "title_align": "left",
              "title_size": "16",
              "type": "query_table"
            },
            "id": 5775187560481180,
            "layout": {
              "height": 4,
