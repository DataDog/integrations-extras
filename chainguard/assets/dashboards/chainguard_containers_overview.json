    {
      "definition": {
        "background_color": "blue",
        "layout_type": "ordered",
        "show_title": true,
        "title": "Chainguard Containers Coverage",
        "type": "group",
        "widgets": [
          {
            "definition": {
              "autoscale": true,
              "precision": 1,
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "(query2 / query4) * 100"
                    }
                  ],
                  "queries": [
                    {
                      "aggregator": "sum",
                      "data_source": "metrics",
                      "name": "query2",
                      "query": "count:container.cpu.usage{git.repository_url:*chainguard*,$env,$cluster_name,$short_image}"
                    },
                    {
                      "aggregator": "sum",
                      "data_source": "metrics",
                      "name": "query4",
                      "query": "count:container.cpu.usage{$env,$cluster_name,$short_image}"
                    }
                  ],
                  "response_format": "scalar"
                }
              ],
              "timeseries_background": {
                "type": "area"
              },
              "title": "Chainguard Coverage",
              "title_align": "left",
              "title_size": "16",
              "type": "query_value"
            },
            "id": 1715121833547002,
            "layout": {
              "height": 2,
              "width": 4,
              "x": 0,
              "y": 0
            }
          },
          {
            "definition": {
              "legend_columns": [
                "avg",
                "min",
                "max",
                "value",
                "sum"
              ],
              "legend_layout": "auto",
              "requests": [
                {
                  "display_type": "bars",
                  "formulas": [
                    {
                      "alias": "Chainguard images",
                      "formula": "query2",
                      "style": {
                        "palette": "green"
                      }
                    },
                    {
                      "alias": "Other images",
                      "formula": "query4",
                      "style": {
                        "palette": "red"
                      }
                    }
                  ],
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "query2",
                      "query": "count:container.cpu.usage{git.repository_url:*chainguard*,$env,$cluster_name,$short_image} by {image_name}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "query4",
                      "query": "count:container.cpu.usage{!git.repository_url:*chainguard*,$env,$cluster_name,$short_image} by {image_name}"
                    }
                  ],
                  "response_format": "timeseries",
                  "style": {
                    "line_type": "solid",
                    "line_width": "normal",
                    "order_by": "values",
                    "palette": "dog_classic"
                  }
                }
              ],
              "show_legend": true,
              "title": "Chainguard Containers Coverage ",
              "title_align": "left",
              "title_size": "16",
              "type": "timeseries",
              "yaxis": {
                "include_zero": false,
                "scale": "log"
              }
            },
            "id": 5803969548554792,
            "layout": {
              "height": 7,
