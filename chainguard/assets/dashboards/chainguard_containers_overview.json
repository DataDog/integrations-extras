    {
      "definition": {
        "background_color": "vivid_green",
        "layout_type": "ordered",
        "show_title": true,
        "title": "Existing Container Trends",
        "type": "group",
        "widgets": [
          {
            "definition": {
              "group": [
                "git.repository_url"
              ],
              "no_group_hosts": true,
              "no_metric_hosts": true,
              "node_type": "container",
              "requests": {
                "fill": {
                  "q": "avg:process.stat.container.memory.rss{*} by {host}"
                }
              },
              "scope": [],
              "style": {
                "palette": "green_to_orange",
                "palette_flip": false
              },
              "title": "Memory Usage Per Container",
              "title_align": "left",
              "title_size": "16",
              "type": "hostmap"
            },
            "id": 1568298405656474,
            "layout": {
              "height": 10,
              "width": 6,
              "x": 0,
              "y": 0
            }
          },
          {
            "definition": {
              "requests": [
                {
                  "formulas": [
                    {
                      "formula": "query1 / (86400000)"
                    }
                  ],
                  "queries": [
                    {
                      "aggregator": "max",
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "max:contimage.max_image_age{status:running,$env,$cluster_name,$short_image} by {image_name}"
                    }
                  ],
                  "response_format": "scalar",
                  "sort": {
                    "count": 25,
                    "order_by": [
                      {
                        "index": 0,
                        "order": "desc",
                        "type": "formula"
                      }
                    ]
                  }
                }
              ],
              "style": {},
              "title": "Top 25 Longest Running Containers",
              "title_align": "left",
              "title_size": "16",
              "type": "toplist"
            },
            "id": 8758955597320810,
            "layout": {
              "height": 6,
              "width": 6,
              "x": 6,
              "y": 0
            }
          },
          {
            "definition": {
              "has_search_bar": "auto",
              "requests": [
                {
                  "formulas": [
                    {
                      "cell_display_mode": "bar",
                      "formula": "timeshift(query1, 40)"
                    }
                  ],
                  "queries": [
                    {
                      "aggregator": "last",
                      "data_source": "metrics",
                      "name": "query1",
                      "query": "count:container.cpu.usage{$env,$cluster_name,$short_image} by {image_name,git.repository_url}.fill(60)"
                    }
                  ],
                  "response_format": "scalar",
                  "sort": {
                    "count": 20,
